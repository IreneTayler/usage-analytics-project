{
    "info": {
        "name": "Usage Analytics with Caching API",
        "description": "API endpoints for testing the usage analytics system with caching",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3003",
            "type": "string"
        },
        {
            "key": "apiKey",
            "value": "dev-usage-analytics-secret",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Health Check",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/health",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "health"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Get Usage Stats (7 days)",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{apiKey}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/usage/stats",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "usage",
                        "stats"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Get Usage Stats (14 days)",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{apiKey}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/usage/stats?days=14",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "usage",
                        "stats"
                    ],
                    "query": [
                        {
                            "key": "days",
                            "value": "14"
                        }
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Get Usage Stats (30 days)",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{apiKey}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/usage/stats?days=30",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "usage",
                        "stats"
                    ],
                    "query": [
                        {
                            "key": "days",
                            "value": "30"
                        }
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Clear All Cache",
            "request": {
                "method": "DELETE",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{apiKey}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/cache/clear",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "cache",
                        "clear"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Cleanup Old Cache (24h)",
            "request": {
                "method": "DELETE",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{apiKey}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/cache/cleanup?hours=24",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "cache",
                        "cleanup"
                    ],
                    "query": [
                        {
                            "key": "hours",
                            "value": "24"
                        }
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Test Cache Performance",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Response time is acceptable', function () {",
                            "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                            "});",
                            "",
                            "pm.test('Cache info is present', function () {",
                            "    const jsonData = pm.response.json();",
                            "    pm.expect(jsonData).to.have.property('cache_info');",
                            "    pm.expect(jsonData.cache_info).to.have.property('cache_hit_rate');",
                            "});",
                            "",
                            "pm.test('Status code is 200', function () {",
                            "    pm.response.to.have.status(200);",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{apiKey}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/usage/stats?days=7",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "usage",
                        "stats"
                    ],
                    "query": [
                        {
                            "key": "days",
                            "value": "7"
                        }
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Test Invalid API Key",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status code is 401', function () {",
                            "    pm.response.to.have.status(401);",
                            "});",
                            "",
                            "pm.test('Error message is correct', function () {",
                            "    const jsonData = pm.response.json();",
                            "    pm.expect(jsonData.error.code).to.eql('UNAUTHORIZED');",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer invalid-key",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/usage/stats",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "usage",
                        "stats"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Test Invalid Days Parameter",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status code is 400', function () {",
                            "    pm.response.to.have.status(400);",
                            "});",
                            "",
                            "pm.test('Error message is correct', function () {",
                            "    const jsonData = pm.response.json();",
                            "    pm.expect(jsonData.error.code).to.eql('INVALID_PARAMETER');",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{apiKey}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/usage/stats?days=999",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "usage",
                        "stats"
                    ],
                    "query": [
                        {
                            "key": "days",
                            "value": "999"
                        }
                    ]
                }
            },
            "response": []
        }
    ]
}