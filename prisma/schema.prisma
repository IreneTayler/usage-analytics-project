generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model users {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  name        String?
  plan_tier   String   @default("starter")
  created_at  DateTime @default(now())
}

model daily_usage_events {
  id           Int      @id @default(autoincrement())
  user_id      Int
  date_key     String
  request_id   String
  status       String
  reserved_at  DateTime @default(now())
  committed_at DateTime?
  created_at   DateTime @default(now())
}

model daily_usage_cache {
  id         Int      @id @default(autoincrement())
  user_id    Int
  date_key   String
  committed  Int
  reserved   Int
  updated_at DateTime @updatedAt

  @@unique([user_id, date_key])
}
