// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model users {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  name       String
  plan_tier  String   // starter, pro, executive
  api_key    String   @unique
  created_at DateTime @default(now())

  // Relations
  daily_usage_events daily_usage_events[]
  daily_usage_cache  daily_usage_cache[]
}

model daily_usage_events {
  id           Int       @id @default(autoincrement())
  user_id      Int
  date_key     String    // YYYY-MM-DD format
  request_id   String    @unique
  status       String    // 'reserved' or 'committed'
  reserved_at  DateTime
  committed_at DateTime?
  created_at   DateTime  @default(now())

  // Relations
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, date_key])
  @@index([user_id, status])
}

// Таблица для кэширования предвычисленных дневных агрегатов
model daily_usage_cache {
  id         Int      @id @default(autoincrement())
  user_id    Int
  date_key   String   // YYYY-MM-DD format
  committed  Int      @default(0) // Количество committed запросов за день
  reserved   Int      @default(0) // Количество активных reserved запросов (не старше 15 мин)
  total      Int      @default(0) // Общее количество запросов за день
  updated_at DateTime @default(now()) @updatedAt
  created_at DateTime @default(now())

  // Relations
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Уникальный индекс для пары user_id + date_key
  @@unique([user_id, date_key], name: "user_id_date_key")
  @@index([updated_at]) // Для поиска устаревших записей
}